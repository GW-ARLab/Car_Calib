# ========================================================================== #
# Raspberry Pi 5 vision — publishes steering over MQTT (no GPIO)
# ========================================================================== #
# Copy to .env, set MQTT_BROKER_HOST to the Pi4 broker, then:
#   ./deploy_jetson.sh
# ========================================================================== #
JETSON_HOST=100.100.1.1
JETSON_PASSWORD=1

# --- Main loop ---
MAIN_TARGET_HZ=30
MAIN_CAMERA_INDEX=0
MAIN_CSV_LOG_FILE=run_log.csv
MAIN_FLIP_FRAME=false
MAIN_TERMINAL_LOG=true
MAIN_DEBUG_MODE=true
MAIN_SHOW_DETECTOR_DEBUG=true
MAIN_FRAME_WIDTH=640
MAIN_FRAME_HEIGHT=480

# --- Steering (logical 0-180 angle, mapped/published over MQTT) ---
SERVO_CENTER_ANGLE=-8
MAX_STEERING_OFFSET=60

# --- MQTT (Pi5 vision -> Pi4 DataProcessingCenter) ---
MQTT_BROKER_HOST=192.168.x.x
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_RASPI5_CONTROL_TOPIC=car/raspi5/control

# --- Manual joystick override (dashboard) ---
MANUAL_OVERRIDE_ENABLED=true

# --- Vision detector ---
ROI_HEIGHT_PCT=0.6
ROI_TOP_WIDTH_PCT=0.75
ROI_BOTTOM_WIDTH_PCT=1.0
ROBOT_DEBUG_MODE=false
VISION_CLAHE_CLIP_LIMIT=2.0
VISION_CLAHE_TILE_GRID_W=8
VISION_CLAHE_TILE_GRID_H=8
VISION_BLUR_KERNEL_W=5
VISION_BLUR_KERNEL_H=5
VISION_CANNY_LOW=50
VISION_CANNY_HIGH=150
VISION_HOUGH_THRESHOLD=40
VISION_HOUGH_MIN_LINE_LENGTH=40
VISION_HOUGH_MAX_LINE_GAP=20
VISION_MIN_ABS_SLOPE=0.3
VISION_CLUSTER_ANGLE_DEG=7.5
VISION_CLUSTER_DIST_PX=30.0
VISION_MIN_GROUP_TOTAL_LENGTH_PX=100.0

# --- Steering controller ---
VP_INNER_THRESH=3.0
VP_OUTER_THRESH=8.0
DANGER_MARGIN_PX=130
DANGER_NUDGE_DEG=10.0
CTRL_HYSTERESIS_HIGH=5.0
CTRL_HYSTERESIS_LOW=3.0
PID_KP=0.9
PID_KD=0.08
PID_CALIBRATION_CLEAR_TOLERANCE_DEG=1.0

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Generate a long random value before deploying; LAN dashboard will not start without it.
DASHBOARD_TOKEN=
DASHBOARD_STREAM_MAX_CLIENTS=2
DASHBOARD_STREAM_FPS=8
DASHBOARD_STREAM_JPEG_QUALITY=60
DASHBOARD_MAX_BODY_BYTES=65536
DASHBOARD_REQUEST_TIMEOUT_S=5
DASHBOARD_MAX_THREADS=16
DASHBOARD_ROUTE_LIST_CACHE_S=5

# Storage protection
LOG_ROTATE_MB=64
DATA_RETENTION_DAYS=7
DATA_MAX_BYTES=2147483648
DISK_MIN_FREE_BYTES=536870912
ROUTE_MAX_STEPS=64
ROUTE_MAX_STEP_DURATION_S=30
ROUTE_MAX_TOTAL_DURATION_S=300

# ========================================================================== #
# Remote deploy (add these to .env.jetson before running deploy_jetson_remote.sh)
# ========================================================================== #
# JETSON_HOST=192.168.x.x
# JETSON_USER=root
# JETSON_PORT=22
# JETSON_PASSWORD=yourpassword     # leave blank to use SSH key
# JETSON_DEST_DIR=/opt/car-calib-jetson
