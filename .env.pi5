# ========================================================================== #
# Raspberry Pi 5 vision — publishes steering over MQTT (no GPIO)
# ========================================================================== #
# Copy to .env, set MQTT_BROKER_HOST to the Pi4 broker, then:
#   ./deploy_pi5.sh
# ========================================================================== #
PI5_HOST=192.168.0.10
PI5_PASSWORD=1

# --- Main loop ---
MAIN_TARGET_HZ=30
MAIN_CAMERA_INDEX=0
MAIN_CSV_LOG_FILE=run_log.csv
MAIN_FLIP_FRAME=false
MAIN_TERMINAL_LOG=true
MAIN_DEBUG_MODE=true
MAIN_SHOW_DETECTOR_DEBUG=true
MAIN_FRAME_WIDTH=640
MAIN_FRAME_HEIGHT=480

# --- Steering (logical 0-180 angle, mapped/published over MQTT) ---
# Values carried over from env.control-direct (tuned on the real car).
SERVO_CENTER_ANGLE=-28
MAX_STEERING_OFFSET=80
SERVO_REVERSE=false

# --- MQTT (Pi5 vision -> Pi4 DataProcessingCenter) ---
MQTT_BROKER_HOST=192.168.x.x
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_RASPI5_CONTROL_TOPIC=car/raspi5/control

# --- Manual joystick override (dashboard) ---
MANUAL_OVERRIDE_ENABLED=true

# --- Vision detector ---
# Values below carried over as-is from env.control-direct (tuned on the
# real car). VP_INNER_THRESH/VP_OUTER_THRESH/DANGER_MARGIN_PX are not set
# in that file (it relies on config/settings.py defaults for those) --
# kept here unchanged from the previous Pi5 defaults; verify on the car.
ROI_HEIGHT_PCT=0.6
ROI_TOP_WIDTH_PCT=0.75
ROI_BOTTOM_WIDTH_PCT=1.0
ROBOT_DEBUG_MODE=false
VISION_CLAHE_CLIP_LIMIT=2.0
VISION_CLAHE_TILE_GRID_W=8
VISION_CLAHE_TILE_GRID_H=8
VISION_BLUR_KERNEL_W=5
VISION_BLUR_KERNEL_H=5
VISION_CANNY_LOW=50
VISION_CANNY_HIGH=150
VISION_HOUGH_RHO=1.0
VISION_HOUGH_THETA_DEG=1.0
VISION_HOUGH_THRESHOLD=50
VISION_HOUGH_MIN_LINE_LEN=30
VISION_HOUGH_MAX_LINE_GAP=10
VISION_ANGLE_THRESHOLD_DEG=5.0
VISION_CLUSTER_ANGLE_BIAS_DEG=4.0
VISION_CLUSTER_RHO_BIAS_PX=25.0
VISION_MIDPOINT_THRESHOLD_PX=30.0
VISION_SANITY_MAX_DELTA_DEG=40.0
VISION_HORIZONTAL_MAX_ERROR_DEG=20.0
VISION_MIN_GROUP_TOTAL_LENGTH_PX=120.0
VISION_ROI_BORDER_BLACK_PX=2
VISION_ROI_EDGE_MARGIN_PX=4
VISION_ROI_BOTTOM_CLEAR_ROWS=10
VISION_DEBUG_MASK_FILE=debug_mask.jpg

# --- Steering controller (HeadingController + PID) ---
VP_INNER_THRESH=3.0
VP_OUTER_THRESH=8.0
DANGER_MARGIN_PX=130
DANGER_NUDGE_DEG=15
CTRL_HYSTERESIS_HIGH=5.0
CTRL_HYSTERESIS_LOW=3.0
CTRL_RELOCK_VALID_FRAMES=3
CTRL_SERVO_OUTPUT_DEADBAND_DEG=0.5
CTRL_SERVO_OUTPUT_SLEW_RATE_DEG_PER_S=180.0
PID_KP=1
PID_KI=0.35
PID_KD=0.3
PID_CALIBRATION_CLEAR_TOLERANCE_DEG=1.0

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Generate a long random value before deploying; LAN dashboard will not start without it.
DASHBOARD_TOKEN="ryan"
DASHBOARD_STREAM_MAX_CLIENTS=2
DASHBOARD_STREAM_FPS=8
DASHBOARD_STREAM_JPEG_QUALITY=60
DASHBOARD_MAX_BODY_BYTES=65536
DASHBOARD_REQUEST_TIMEOUT_S=5
DASHBOARD_MAX_THREADS=16
DASHBOARD_ROUTE_LIST_CACHE_S=5

# Storage protection
LOG_ROTATE_MB=64
DATA_RETENTION_DAYS=7
DATA_MAX_BYTES=2147483648
DISK_MIN_FREE_BYTES=536870912
ROUTE_MAX_STEPS=64
ROUTE_MAX_STEP_DURATION_S=30
ROUTE_MAX_TOTAL_DURATION_S=300

# ========================================================================== #
# Remote deploy (add these to .env.pi5 before running deploy_pi5_remote.sh)
# ========================================================================== #
PI5_USER=arlab-speak
PI5_PORT=22
PI5_DEST_DIR=/opt/car-calib-pi5
